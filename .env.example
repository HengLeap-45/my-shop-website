# ==============================================================================
# VELORA E-COMMERCE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` and fill in your credentials.
#
# SECURITY WARNING:
# Only variables prefixed with `VITE_` are exposed to the frontend browser bundle.
# NEVER put secret keys (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY) in
# `VITE_*` variables. Keep all secret keys strictly in server-side functions
# (e.g., Supabase Edge Functions or a dedicated backend API).
#
# Without these variables set, the app runs in Local Demo Mode using sample data
# and localStorage persistence.
# ==============================================================================

# Supabase Project Credentials (public anon key is safe for frontend with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Public Configuration (optional - only publishable key goes in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-side endpoint (e.g. Supabase Edge Function URL) that creates Stripe Checkout Sessions
VITE_STRIPE_CHECKOUT_ENDPOINT=
